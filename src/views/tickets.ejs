<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tickets | Sistema de Soporte</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container wide">
      <section class="card">
        <h1>Gestión de tickets</h1>
        <p>Usuario activo: <strong><%= user.nombre %></strong> (<%= user.rol %>)</p>

        <form method="post" action="/tickets" class="form">
          <h2>Nuevo ticket</h2>
          <label for="titulo">Título</label>
          <input id="titulo" name="titulo" required maxlength="150" />

          <label for="descripcion">Descripción</label>
          <textarea id="descripcion" name="descripcion" required rows="4"></textarea>

          <label for="prioridad">Prioridad</label>
          <select id="prioridad" name="prioridad" required>
            <option value="baja">Baja</option>
            <option value="media" selected>Media</option>
            <option value="alta">Alta</option>
            <option value="critica">Crítica</option>
          </select>

          <button type="submit">Crear ticket</button>
        </form>

        <h2>Listado de tickets</h2>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th><th>Título</th><th>Estado</th><th>Prioridad</th><th>Creado por</th><th>Acción</th>
              </tr>
            </thead>
            <tbody>
              <% tickets.forEach(ticket => { %>
              <tr>
                <td>#<%= ticket.id %></td>
                <td><%= ticket.titulo %></td>
                <td><%= ticket.estado %></td>
                <td><%= ticket.prioridad %></td>
                <td><%= ticket.creado_por_nombre %></td>
                <td>
                  <form method="post" action="/tickets/<%= ticket.id %>/estado" class="inline-form">
                    <select name="estado">
                      <option value="abierto" <%= ticket.estado === 'abierto' ? 'selected' : '' %>>Abierto</option>
                      <option value="en_proceso" <%= ticket.estado === 'en_proceso' ? 'selected' : '' %>>En proceso</option>
                      <option value="resuelto" <%= ticket.estado === 'resuelto' ? 'selected' : '' %>>Resuelto</option>
                      <option value="cerrado" <%= ticket.estado === 'cerrado' ? 'selected' : '' %>>Cerrado</option>
                    </select>
                    <button type="submit">Actualizar</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="actions">
          <a href="/" class="link-btn">Volver al panel</a>
          <form method="post" action="/logout"><button type="submit" class="secondary">Cerrar sesión</button></form>
        </div>
      </section>
    </main>
  </body>
</html>
